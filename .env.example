FORGEJO_URL=https://your-forgejo-instance.com
FORGEJO_TOKEN=your-api-token-here

# Comma-separated tool areas to disable (optional; all enabled by default):
# repository, repo-settings, issues, pull-requests, organizations, users, actions, packages, admin
# FORGEJO_DISABLED_AREAS=admin,actions

# Limits on requests to Forgejo (optional; defaults shown)
# FORGEJO_TIMEOUT_MS=120000
# FORGEJO_MAX_RESPONSE_BYTES=10485760

# Bearer token clients must send to the HTTP endpoint. Optional when running
# the server directly, but required by docker-compose.yml, which will not start
# without it. Generate one with: openssl rand -hex 32
FORGEJO_MCP_API_KEY=

# Other HTTP mode settings (optional)
PORT=3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
