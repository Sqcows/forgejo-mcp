FORGEJO_URL=https://your-forgejo-instance.com
FORGEJO_TOKEN=your-api-token-here

# HTTP mode settings (optional)
FORGEJO_MCP_API_KEY=your-secret-api-key
# Public HTTPS origin advertised in OAuth metadata (Grok Web / custom connectors)
OAUTH_PUBLIC_URL=https://your-public-host.example
PORT=3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
