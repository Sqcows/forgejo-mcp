FORGEJO_URL=https://your-forgejo-instance.com
FORGEJO_TOKEN=your-api-token-here

# Comma-separated tool areas to disable (optional; all enabled by default):
# repository, repo-settings, issues, pull-requests, organizations, users, actions, packages, admin
# FORGEJO_DISABLED_AREAS=admin,actions

# HTTP mode settings (optional)
FORGEJO_MCP_API_KEY=your-secret-api-key
PORT=3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
